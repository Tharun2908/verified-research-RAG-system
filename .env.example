POSTGRES_USER=research
POSTGRES_PASSWORD=research
POSTGRES_DB=research
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
REDIS_HOST=localhost
REDIS_PORT=16379
QDRANT_HOST=localhost
QDRANT_PORT=16333

# Generation. Without this, /verify falls back to a STUB generator (and says so, loudly).
# Get a key at https://openrouter.ai/keys — the demo costs fractions of a cent per query.
OPENROUTER_API_KEY=

# Optional: use a lexical-overlap stub verifier instead of loading the ~700MB DeBERTa.
# Dev only — grounding scores become meaningless. Leave unset for the real verifier.
# DEV_STUB_VERIFIER=true